# Server configuration
PORT=3000
NODE_ENV=development
HOST_PORT=3000
SITE_URL=https://www.evathomatrixsecurity.com
CORS_ORIGINS=
TRUST_PROXY_HOPS=1

# PostgreSQL connection. Docker Compose sets DB_HOST=db for the app container.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evatho_security_db
DB_USER=evatho
DB_PASSWORD=replace-with-a-long-unique-password
